          483.14495849609375,
          46.73999786376953,
          494.13397216796875
        ],
        "font": "SymbolMT",
        "size": 9.0,
        "flags": 0,
        "page": 0
      },
      {
        "text": "Dilara Tekin had via het uitzendbureau een tijdelijke opdracht bij ons.",
        "bbox": [
          56.63999938964844,
          483.7389831542969,
          322.5169982910156,
          494.72796630859375
        ],
        "font": "Aptos",
        "size": 9.0,
        "flags": 4,
        "page": 0
      },
      {
        "text": "We danken alle collega’s voor hun inzet voor onze school en onze leerlingen en wensen hen veel succes met de nieuwe stappen in hun",
        "bbox": [
          42.599998474121094,
          505.69903564453125,
          559.5760498046875,
          516.6880493164062
        ],
