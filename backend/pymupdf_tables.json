          42.599998474121094,
          459.9849548339844,
          46.73999786376953,
          470.9739685058594
        ],
        "font": "SymbolMT",
        "size": 9.0,
        "flags": 0,
        "page": 0
      },
      {
        "text": "AnneMarie Boerman gaat dichter bij huis werken en naar een andere Amos school in Amsterdam-West.",
        "bbox": [
          56.63999938964844,
          460.5789794921875,
          454.5369873046875,
          471.5679626464844
        ],
        "font": "Aptos",
        "size": 9.0,
        "flags": 4,
        "page": 0
      },
      {
        "text": "•",
        "bbox": [
          42.599998474121094,
          471.5049743652344,
          46.73999786376953,
          482.4939880371094
        ],
        "font": "SymbolMT",
        "size": 9.0,
        "flags": 0,
        "page": 0
      },
      {
        "text": "Daphne Hernandez  gaat naar onze zusterschool Poseidon.",
        "bbox": [
          56.63999938964844,
          472.0989990234375,
          287.47698974609375,
          483.0879821777344
        ],
        "font": "Aptos",
